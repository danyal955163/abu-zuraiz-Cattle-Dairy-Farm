# Browser-safe Supabase configuration. These names are read by the Vite client.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Legacy fallback supported for existing projects:
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Never put a service-role key in Vite, GitHub, or public Vercel variables.
# SUPABASE_SERVICE_ROLE_KEY=server-only-never-commit
